{
  "Authentication": {
    "Authority": "https://identity.example.com",
    "Issuer": "https://identity.example.com",
    "Audience": "https://expenses.example.com/mcp"
  },
  "McpSecurity": {
    "Resource": "https://expenses.example.com/mcp",
    "ResourceMetadata": "https://expenses.example.com/.well-known/oauth-protected-resource",
    "AuthorizationServer": "https://identity.example.com",
    "InitialScope": "expenses.read",
    "ToolScopes": {
      "list_expenses": [ "expenses.read" ],
      "approve_expense": [ "expenses.approve" ]
    },
    "ClientScopes": {
      "finance-desktop": [ "expenses.read" ],
      "finance-admin": [ "expenses.read", "expenses.approve" ]
    },
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
